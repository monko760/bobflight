+/* Map erpm_mN / dshot_telem_mN → motor index 0..3; -1 if not a match. */
+static int dshot_cli_motor_index(const char *key, const char *prefix)
+{
+    size_t n;
+    char digit;
+    if (!key || !prefix) {
+        return -1;
+    }
+    n = strlen(prefix);
+    if (strncmp(key, prefix, n) != 0) {
+        return -1;
+    }
+    digit = key[n];
+    if (digit < '1' || digit > '4' || key[n + 1] != '\0') {
+        return -1;
+    }
+    return (int)(digit - '1');
+}
