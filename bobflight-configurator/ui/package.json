{
  "name": "@bobflight/ui",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "smoke": "esbuild scripts/smoke-mock.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/smoke-mock.bundle.mjs && node scripts/smoke-mock.bundle.mjs",
    "clean": "rm -rf dist scripts/smoke-mock.bundle.mjs",
    "test:motors": "esbuild scripts/test-motor-bench.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/test-motor-bench.bundle.mjs && node scripts/test-motor-bench.bundle.mjs"
  },
  "dependencies": {
    "@bobflight/protocol": "file:../protocol",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
