{
  "name": "@bobflight/protocol",
  "version": "0.1.0",
  "description": "BobFlight Configurator host-FC USB CDC CLI transport (clean-room, Apache-2.0)",
  "license": "Apache-2.0",
  "author": "Robert Leclercq",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "smoke": "tsc && node dist/smoke/smoke.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:dfu": "tsc && node tests/dfu.cjs",
    "smoke:settings": "tsc && node dist/smoke/smoke-settings.js",
    "smoke:webserial": "tsc && node dist/smoke/smoke-webserial-node.js",
    "smoke:flasher": "tsc && node dist/smoke/smoke-flasher.js",
    "test:motors": "tsc && node tests/motors.cjs",
    "test:sensors": "tsc && node tests/sensors.cjs && node tests/calibration-persistence.cjs",
    "test:timing": "tsc && node tests/timing.cjs",
    "test:ports-modes": "tsc && node tests/ports-modes.cjs",
    "test:flight-modes": "tsc && node tests/flight-modes.cjs",
    "test:bootloader": "tsc && node tests/bootloader.cjs",
    "test:pid-diagnostics": "tsc && node tests/pid-diagnostics.cjs",
    "test:sd": "tsc && node tests/sd-probe.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist",
    "README.md",
    "DELIVERABLE.md",
    "src/flasher/FLASHER.md"
  ],
  "optionalDependencies": {
    "serialport": "^12.0.0"
  },
  "private": true
}
